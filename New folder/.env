APP_NAME="Smart Attendance Server"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://smart-attendance-hw9c.onrender.com
APP_TIMEZONE="Asia/Kolkata"

# Database Configuration (MySQL default, SQLite fallback supported)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=attendance_db
DB_USERNAME=root
DB_PASSWORD=

# SQLite fallback path if DB_CONNECTION=sqlite
DB_SQLITE_PATH=database/attendance.sqlite

# Session Lifetime (minutes)
SESSION_LIFETIME=120

# Employee Code Prefix
EMPLOYEE_CODE_PREFIX=EMP-
